; Falldin — hex map editor
; Godot 4.4

config_version=5

[application]
config/name="Falldin"
config/description="Hex map editor for the World Map Hex Tiles asset pack."
config/version="0.1.0"
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1600
window/size/viewport_height=960
window/size/mode=2

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1

[gui]
theme/default_font_multichannel_signed_distance_field=true

[input]
pan={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
